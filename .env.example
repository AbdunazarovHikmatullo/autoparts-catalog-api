# Скопируйте файл в .env и при необходимости измените значения
APP_NAME="AutoParts Catalog API"
DEBUG=false

# Параметры PostgreSQL (используются docker-compose)
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=autoparts
POSTGRES_DB=autoparts
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Строка подключения для приложения (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://autoparts:autoparts@db:5432/autoparts

# JWT: обязательно задайте свой длинный случайный ключ
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
